# Select offline for local UI/domain development. Use dev only after middleware is ready.
SPRING_PROFILES_ACTIVE=offline
APP_INFRASTRUCTURE_ENABLED=false
APP_MODEL_RUNTIME_ENABLED=false
APP_ENTERPRISE_SECURITY_CONTEXT_ENABLED=false
APP_LEGAL_AUTOMATION_RELEASE_ENABLED=false
APP_ADMIN_API_ENABLED=false
APP_ADMIN_API_TOKEN=
WORKFLOW_MODEL_CLIENT_ID=law-consultant
WORKFLOW_STORAGE_ROOT=./data/workflows

# Online runtime settings
MYSQL_URL=jdbc:mysql://127.0.0.1:13306/ai-agent-station
MYSQL_USERNAME=root
MYSQL_PASSWORD=
PGVECTOR_URL=jdbc:postgresql://127.0.0.1:15432/springai
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=
APP_LEGAL_VECTOR_TABLE=vector_store_openai
APP_LEGAL_MATTER_STORE=memory
APP_LEGAL_MATTER_SCHEMA_INITIALIZE=false
APP_LEGAL_STORAGE_ROOT=data/legal
APP_LEGAL_MAX_SOURCE_BYTES=209715200
APP_LEGAL_OBJECT_STORAGE_PROVIDER=filesystem
APP_LEGAL_OBJECT_STORAGE_ROOT=data/legal/objects
APP_LEGAL_MINIO_ENDPOINT=http://127.0.0.1:19000
APP_LEGAL_MINIO_ACCESS_KEY=
APP_LEGAL_MINIO_SECRET_KEY=
APP_LEGAL_MINIO_BUCKET=legal-originals
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
APP_LEGAL_INGESTION_BATCH_SIZE=64
APP_LEGAL_CHUNK_MAX_CHARS=1200
APP_LEGAL_CHUNK_OVERLAP_CHARS=120
APP_LEGAL_CONTEXT_BUDGET_CHARS=6000
APP_LEGAL_MAX_CHARS_PER_EVIDENCE=1400
APP_LEGAL_MAX_EVIDENCE_PER_DOCUMENT=4
APP_UPLOAD_MAX_FILE_SIZE=200MB
APP_UPLOAD_MAX_REQUEST_SIZE=210MB
# Third-party chat endpoint requested for gpt-6.1-sol. Verify chat/completions
# compatibility before enabling the runtime; never copy an exposed API key.
AI_OPENAI_BASE_URL=https://xueyangai.com/v1
AI_OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-6.1-sol
AI_EMBEDDING_MODEL=

# Optional tenant-aware retrieval defaults
APP_MODEL_MAX_CONCURRENT_PER_CLIENT=3
APP_MODEL_CIRCUIT_FAILURE_THRESHOLD=3
APP_MODEL_CIRCUIT_OPEN_MS=30000
